@echo off
title ejemplo 1 - programacion batch
echo "Sistemas operativos I"
pause
exit

:: @echo off = Función: Desactiva la visualización de los comandos que se ejecutan en el script en la consola.
:: title = Función: Cambia el título de la ventana de la consola.
:: echo = Función: Muestra un mensaje en la consola.
:: pause = Función: Pausa la ejecución del script hasta que el usuario presione una tecla.
:: exit = Función: Finaliza la ejecución del script.