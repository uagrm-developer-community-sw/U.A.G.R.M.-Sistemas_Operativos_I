      "boundElements": [],
      "updated": 1737694259289,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "+ Ready (Listo o Preparado)\nEl proceso no tiene impedimentos para correr, pero la CPU\nestá corriendo el código de otro proceso.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+ Ready (Listo o Preparado)\nEl proceso no tiene impedimentos para correr, pero la CPU\nestá corriendo el código de otro proceso.",
      "lineHeight": 1.25,
      "baseline": 68
    },
    {
