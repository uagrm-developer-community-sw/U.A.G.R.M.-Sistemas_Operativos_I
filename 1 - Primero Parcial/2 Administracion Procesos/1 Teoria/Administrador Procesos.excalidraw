      "boundElements": [],
      "updated": 1737694259289,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "+ Wait (Espera o bloqueado)\nEl proceso tiene impedimentos para correr: Está esperando\na que uno de sus subprocesos finalice.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+ Wait (Espera o bloqueado)\nEl proceso tiene impedimentos para correr: Está esperando\na que uno de sus subprocesos finalice.",
      "lineHeight": 1.25,
      "baseline": 68
    },
